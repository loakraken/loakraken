# 운영 서버의 /opt/loakraken/<스택>/stack.env 로 복사해 쓴다. 비밀값은 이 파일에 쓰지 않는다.
# 비밀값은 SECRETS_DIR 아래 파일(db_password, valkey_password, lostark_api_key)로 둔다.

STACK_NAME=loakraken
SITE_ADDRESS=loakraken.example
SECRETS_DIR=/opt/loakraken/secrets

# 이미지 태그는 배포 워크플로가 커밋 SHA로 지정한다.
API_IMAGE=ghcr.io/loakraken/loakraken-api:sha-0000000
WEB_IMAGE=ghcr.io/loakraken/loakraken-web:sha-0000000

POSTGRES_DB=loakraken
POSTGRES_USER=loakraken

# 공식 API 호출 한도를 쓰는 백그라운드 작업. 운영 스택 1곳에서만 true로 둔다.
STATS_COLLECTOR_ENABLED=false
MARKET_WARMUP_ENABLED=false

# 4GB 서버 기준 메모리 배분(추정). 실측 후 조정한다.
API_MEM_LIMIT=1280m
WEB_MEM_LIMIT=768m
POSTGRES_MEM_LIMIT=768m
VALKEY_MEM_LIMIT=256m
