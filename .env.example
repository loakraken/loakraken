# 로컬 개발용 예시입니다. .env로 복사한 뒤 환경에 맞게 변경하세요.
# 실제 운영 비밀번호와 API 키는 이 파일에 작성하지 않습니다.
POSTGRES_DB=loakraken
POSTGRES_USER=loakraken
POSTGRES_PASSWORD=loakraken-local
POSTGRES_PORT=5432
VALKEY_PORT=6379

# 발급받은 키는 .env 또는 실행 환경에만 설정합니다.
LOSTARK_API_KEY=

# 장기 보관·재제공 범위를 확인한 환경에서만 활성화합니다.
CHARACTER_SNAPSHOTS_ENABLED=false
