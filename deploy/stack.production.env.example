# 운영 스택 설정 예시. 서버의 /opt/loakraken/production/stack.env 로 복사해 쓴다.
# 비밀값은 이 파일에 쓰지 않는다. SECRETS_DIR 아래 파일(db_password, valkey_password, lostark_api_key, roster_marker_secret)로 둔다.
# roster_marker_secret은 스택마다 따로 만든 32바이트 이상 임의 값이다(예: openssl rand -hex 32). 바꾸면 원정대 불러오기 표시가 초기화된다.
# lostark_api_key에는 **운영 키("LOAKraken Production")만** 넣는다. 개발 키를 넣지 않는다.

STACK_NAME=loakraken
SITE_ADDRESS=loakraken.gg
# Cloudflare 프록시 뒤 운영(사용자 결정 10-09): 실제 IP는 CF-Connecting-IP, HTTPS는 Origin CA 인증서(SECRETS_DIR/tls). 운영 문서 cloudflare
CADDYFILE=Caddyfile.cloudflare
# 사이트 기준 URL. 운영에서만 이 값이다(robots 색인 허용 조건).
SITE_URL=https://loakraken.gg
# 치명 계산 도구(치적)는 첫 운영 배포에서 제외한다(PM 총괄 결정 10-09, web #233). 공개할 때 on으로 바꾼다.
CRIT_SPEED_TOOL=off
# 전투력 시뮬레이터 화면(web #365)도 공개 기준 전까지 숨긴다(백엔드 COMBAT_POWER_SIM_ENABLED=false와 함께).
COMBAT_POWER_SIM=off
# 원정대 영수증 화면도 계산 재대조 전까지 숨긴다(PM 총괄 10-11, api RECEIPT_ENABLED=false와 함께).
RECEIPT_TOOL=off
# 캐릭터 '세팅 점검' 탭도 표본이 모일 때까지 숨긴다(web #489, 켤 때 on).
SETTING_CHECK_TAB=off
# 원정대 랭킹 화면(web #515)과 전투정보실 페이지 정보(web #519)도 공개 판단 때 백엔드 플래그와 함께 on.
ROSTER_RANKING=off
ARMORY_PAGE=off
# 나머지 화면 스위치(오픈 준비 A3). 공개 판단 때 백엔드 짝과 같이 on.
ACCESSORY_SEARCH_TOOL=off
CHARACTER_EFFICIENCY=off
COLLECTIBLE_RANKING=off
EFFICIENCY_RANKING=off
GUILD_RANKING=off
POPULAR_GUILDS=off
GUILD_TAB=off
SPEC_UP_GUIDE=off
TITLE_STATS=off
CHARACTER_INDEXING=off
PRICE_ALERTS=off
# 검색 엔진 소유 확인 코드(공개 값). 도메인 연결 뒤 각 검색 엔진 화면에서 받아 넣고 web만 다시 만든다. 비우면 태그 없음.
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=
# 백엔드 기능 플래그(#214). 비워도 꺼지지만 운영은 명시한다. web 공개 판단 때 web 플래그와 함께 켠다.
CRIT_SPEED_ENABLED=false
GEM_ENABLED=false
# 팔찌·젬 효율 랭킹을 실 효율로(#647). 켤 때 EFFICIENCY_RANKING=on과 함께 true(GEM_ENABLED와는 무관).
STATS_EFFICIENCYRANKING_REAL=false
RECEIPT_ENABLED=false
# 전투력 시뮬레이터: 보석·재련·각인 계산식이 계산 검증을 통과한 뒤에만 켠다(PM 총괄 10-10).
COMBAT_POWER_SIM_ENABLED=false
# 수집품(내실) 랭킹: 웹 화면 공개 때 켠다.
RANKING_COLLECTIBLES_ENABLED=false
# 수집품 보유율 예열: 수집품 랭킹이 켜져 있을 때만 돈다.
RANKING_COLLECTIBLES_WARMUP_ENABLED=true
# 원정대 랭킹: 웹 화면 공개 때 켠다.
RANKING_ROSTERS_ENABLED=false
# 캐릭터 길드 탭·인기 길드: 웹 화면 공개 때 켠다.
RANKING_GUILDS_ENABLED=false
# 길드 랭킹 API: 길드 탭과 따로, 웹 길드 랭킹 화면 공개 때 켠다.
RANKING_GUILDS_LIST_ENABLED=false
# 칭호 장착 확인 비율: 웹 화면 공개 때 켠다.
RANKING_TITLES_ENABLED=false
# 나머지 백엔드 기능 스위치(오픈 준비 A3). 시세 알림은 VAPID 키를 준비한 뒤에만 켠다.
SPEC_UP_ENABLED=false
# 스펙업 완갑 재련 줄: 기본 켬. 끄면 목록·줄 상세에서 뺀다.
SPEC_UP_ARM_GUARD_ENABLED=true
# 재련 계획 숨결 OPTIMAL: 웹 화면(v0.3.4)과 같이 켠다. 꺼져 있으면 breath=OPTIMAL은 400.
REFINING_OPTIMAL_ENABLED=false
FEATURE_AUCTION_SEARCH=false
# 보석 매물 직업·스킬 필터: 끄면 false(화면은 필터를 숨김), 몫은 분당 공식 호출 수
MARKET_GEM_FILTER_ENABLED=true
MARKET_GEM_FILTER_QUOTA=10
ALERTS_PUSH_ENABLED=false
# 전투정보실 페이지 정보: 웹 ARMORY_PAGE와 함께 켠다. 연락 주소는 서비스 안내 페이지 또는 서비스 전용 메일(개인 메일 금지).
ARMORY_PAGE_ENABLED=false
ARMORY_PAGE_CONTACT=
# 스킬 코드: 페이지 정보가 켜져 있을 때만 동작, 따로 켠다.
ARMORY_PAGE_SKILL_CODE_ENABLED=false
# 크라켄 점수: 웹 화면 스위치와 함께 켠다. 공식 호출은 늘지 않는다.
KRAKEN_SCORE_ENABLED=false
SECRETS_DIR=/opt/loakraken/production/secrets

# pull 배포(운영 문서 deploy): 서버가 따라갈 GHCR 채널 태그와 레지스트리.
DEPLOY_CHANNEL=production
DEPLOY_REGISTRY=ghcr.io/loakraken
# 운영 승인: required면 서버에서 sudo pull/approve.sh로 승인한 릴리스만 배포한다(비워도 운영은 required).
DEPLOY_APPROVAL=required

# 이미지 태그는 배포 워크플로가 images.env로 지정한다(운영은 sha- 태그만).

POSTGRES_DB=loakraken
# DB 소유자(Flyway·백업, 비밀 파일 db_password). api 실행은 따로 loakraken_app 역할(비밀 파일 db_app_password, deploy/sql/db-app-role.sql로 만든다).
POSTGRES_USER=loakraken

# 공식 API 호출 한도를 쓰는 백그라운드 작업. 운영 스택에서만 true다.
STATS_COLLECTOR_ENABLED=true
# 시드 목록(#255). 쉼표 구분 이름은 운영 서버 stack.env에만 쓴다(저장소 커밋 금지).
STATS_SEED_ENABLED=false
STATS_SEED_NAMES=
# 이름이 많으면 파일로: 스택 디렉터리 seed/names.txt(한 줄에 한 이름) + 아래 값. 파일 내용만 바꾸면 설정이 같아 up -d api로는 다시 만들어지지 않으므로 up -d --wait --force-recreate api.
STATS_SEED_FILE=
MARKET_WARMUP_ENABLED=true
# 시세 예열 세부. 재련 재료·유물 각인서는 공식 호출이 늘어 기본 꺼짐.
MARKET_WARMUP_REFINING_MATERIALS_ENABLED=false
MARKET_WARMUP_RELIC_BOOKS_ENABLED=false
# 수집기 속도(기본 3s·40). 공개 전 한시로만 1s·25를 쓰고, 도메인 공개 전에 이 값으로 되돌린다(출시 점검표).
STATS_COLLECTOR_INTERVAL=3s
STATS_COLLECTOR_RESERVE=40
# 방문자별 분당 공식 호출 한도(기본 20). 부하 대응 2단계에서만 10으로 낮추고, 경보가 15분 조용하면 20으로 되돌린다.
CLIENT_LIMIT_OFFICIAL=20
# 요청 본문 크기 상한(기본 64KB). 앞단 프록시 상한(256KB)보다 작게 둔다.
HTTP_MAX_REQUEST_BODY=64KB
# 검색봇 전체의 분당 공식 호출 상한(기본 20). 캐릭터 페이지 색인(CHARACTER_INDEXING=on)을 켤 때 10으로 낮춘다.
CLIENT_LIMIT_BOT_OFFICIAL=20

# web↔api 망(app)과 백엔드가 믿는 프록시(web) 주소. 셋은 함께 바꾼다(운영 문서 deploy "배포 조건").
# 망을 나누기 전 internal 망(172.31.250.0/24)과 겹치지 않게 새 대역을 쓴다(옛 망은 되돌리기를 위해 한동안 서버에 남는다).
APP_SUBNET=172.31.249.0/24
WEB_APP_IP=172.31.249.10
TRUSTED_PROXY_REGEX=172\.31\.249\.10
# 수집용 망(api·prometheus)과 api 관리 포트 주소. 다른 망(위 APP_SUBNET, 같은 서버의 다른 환경)과 겹치지 않게 한다.
METRICS_SUBNET=172.31.252.0/24
API_METRICS_IP=172.31.252.10

# 4GB 서버 기준 메모리 배분(모니터링 몫 포함, 한도 합 약 3.3GB + 스왑 2GB). 모두 동시에 차지 않는다는 전제.
API_MEM_LIMIT=1024m
WEB_MEM_LIMIT=512m
POSTGRES_MEM_LIMIT=640m
# postgres shared_buffers는 한도의 약 25%. 비우면 postgres 기본값 128MB.
POSTGRES_SHARED_BUFFERS=160MB
VALKEY_MEM_LIMIT=192m
VALKEY_MAXMEMORY=128mb
EDGE_MEM_LIMIT=128m

# 모니터링(compose 프로필 monitor: prometheus·node-exporter·grafana·cloudflared). 켜려면 COMPOSE_PROFILES=monitor.
# 켜기 전에 비밀 디렉터리에 grafana_admin_password(사용자가 서버에서 만듦)·cloudflared_token(Cloudflare 터널 화면의 토큰)·
# slack_webhook_alerts(이미 있음)가 있어야 한다. 셋 다 컨테이너가 일반 사용자로 읽으므로 444(디렉터리 700이 막는다).
# 공개 대시보드는 monitor/grafana/fetch-dashboards.sh로 한 번 받아 둔다. 끄려면 비운다.
COMPOSE_PROFILES=
PROMETHEUS_MEM_LIMIT=384m
NODE_EXPORTER_MEM_LIMIT=48m
GRAFANA_MEM_LIMIT=512m
CLOUDFLARED_MEM_LIMIT=64m
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=1GB
# 경보 메시지의 링크 주소와 쿠키(터널+Access로 https 접속). SSH 터널만 쓰면 http://localhost:3000·false.
GRAFANA_ROOT_URL=https://grafana.loakraken.gg
GRAFANA_COOKIE_SECURE=true
