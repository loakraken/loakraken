# 스테이징 스택 설정 예시. 서버의 /opt/loakraken/staging/stack.env 로 복사해 쓴다.
#
# 키 규칙(PM 총괄 결정 2026-10-09)
# - lostark_api_key에는 **개발 키(기존 "LOAKraken" 클라이언트)** 를 넣는다. 운영 키를 넣지 않는다.
# - 공식 한도는 키별(100회/분)이라 Valkey가 달라도 운영 예산과 섞이지 않는다.
# - 개발 키는 로컬 수집기(분당 약 20회)와 다른 팀 로컬 인스턴스도 함께 쓴다. 스테이징 점검 중 429가 날 수 있으나 운영에는 영향이 없다.
# - 수집기·예열은 false로 고정한다.

STACK_NAME=loakraken-staging
SITE_ADDRESS=:80
# 운영과 다른 기준 URL이라 robots가 색인을 막는다(같은 이미지를 씀).
SITE_URL=http://127.0.0.1:8081
SECRETS_DIR=/opt/loakraken/staging/secrets

# 같은 서버에서 운영 edge가 80/443을 쓰므로, 스테이징은 서버 안(127.0.0.1)에만 연다.
# 접속은 SSH 터널로 한다: ssh -L 8081:127.0.0.1:8081 deploy@서버 → http://127.0.0.1:8081
EDGE_HTTP_PORT=127.0.0.1:8081
EDGE_HTTPS_PORT=127.0.0.1:8444

POSTGRES_DB=loakraken
POSTGRES_USER=loakraken

STATS_COLLECTOR_ENABLED=false
MARKET_WARMUP_ENABLED=false

# 운영과 서브넷이 겹치지 않게 한다. 셋은 함께 바꾼다.
INTERNAL_SUBNET=172.31.251.0/24
WEB_INTERNAL_IP=172.31.251.10
TRUSTED_PROXY_REGEX=172\.31\.251\.10

# 운영과 한 서버에 올릴 때는 작게 잡는다(추정).
API_MEM_LIMIT=768m
WEB_MEM_LIMIT=384m
POSTGRES_MEM_LIMIT=384m
VALKEY_MEM_LIMIT=128m
